# Discord webhook URL for alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# OpenSea API key (get from https://docs.opensea.io/reference/api-keys)
OPENSEA_API_KEY=your_opensea_api_key_here

# Polygon RPC URL (Alchemy, Infura, or public)
POLYGON_RPC_URL=https://polygon-rpc.com

# EV thresholds
MIN_EV_RATIO=2.0
MAX_EV_RATIO=10.0

# Scan interval in seconds
SCAN_INTERVAL_SECONDS=300

# Courtyard collection slug on OpenSea
COURTYARD_COLLECTION_SLUG=courtyard-nft

# Courtyard ERC-721 contract on Polygon
COURTYARD_CONTRACT_ADDRESS=0x251be3a17af4892035c37ebf5890f4a4d889dcad
